<?xml version="1.0" encoding="utf-8"?>
<!-- Every privileged permission the app requests must be listed here, otherwise
     devices with ro.control_privapp_permissions=enforce refuse to boot. -->
<permissions>
    <privapp-permissions package="com.bergamota.asistan">
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    </privapp-permissions>
</permissions>
