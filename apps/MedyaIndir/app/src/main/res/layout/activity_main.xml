<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Link"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://…  (Instagram, YouTube, TikTok, X…)"
            android:inputType="textUri"
            android:minHeight="48dp" />

        <Button
            android:id="@+id/yapistir"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panodan yapıştır" />

        <RadioGroup
            android:id="@+id/tur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Video" />

            <RadioButton
                android:id="@+id/ses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Yalnızca ses" />
        </RadioGroup>

        <Button
            android:id="@+id/indir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="İNDİR" />

        <ProgressBar
            android:id="@+id/cubuk"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="1000"
            android:visibility="gone" />

        <TextView
            android:id="@+id/durum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Dosyalar telefonun İndirilenler/MedyaIndir klasörüne kaydedilir. Diğer uygulamalarda Paylaş → Medya İndir ile de link gönderebilirsiniz. Yalnızca indirme hakkınız olan içerikleri indirin."
            android:textColor="#757575"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
