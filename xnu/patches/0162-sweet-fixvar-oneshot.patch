+/*
+ * SWEET: boot-arg sweetfixvar=1 repairs a /var that was turned from the symlink
+ * (-> private/var) into a real directory. See sweet_fixvar() in vfs_syscalls.c.
+ * One-shot: drop the boot-arg after.
+ */
+extern void sweet_fixvar(void);
+
+static void
+sweet_fixvar_once(void)
+{
+	uint32_t on = 0;
+
+	if (!PE_parse_boot_argn("sweetfixvar", &on, sizeof(on)) || on != 1) {
+		return;
+	}
+	sweet_fixvar();
+}
