+/*
+ * boot-arg sweettouchstep=<ms>: pause after each bring-up step so the live/persistent log gets the
+ * last line out before a step that resets the SoC (both lose the final second otherwise).
+ */
+static unsigned touch_step_ms;
+#define TOUCH_STEP() do { if (touch_step_ms) touch_wait(touch_step_ms); } while (0)
+
+/* Mi 8: ST FTM5 at 0x49. Its reset pin is touch-only, so a pulse is safe. */
+static bool
+touch_dipper_start(void)
+{
+	printf("SWEET TOUCH: TLMM rst%u=%#x/%#x irq%u=%#x/%#x sda=%#x scl=%#x\n",
+	    tb->rst, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->rst)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->rst)),
+	    tb->irq, touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->irq)), touch_rd(st.gpio, TOUCH_GPIO_IO(tb->irq)),
+	    touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->sda)), touch_rd(st.gpio, TOUCH_GPIO_CFG(tb->scl)));
+	TOUCH_STEP();
+	touch_gpio(tb->irq, 0, 3, 0, false, false);       /* input, pull-up (active-low level IRQ) */
+	if (st.bitbang) {
+		touch_gpio(tb->sda, 0, 0, 0, false, false);
+		touch_gpio(tb->scl, 0, 0, 0, false, false);
+	} else {
+		touch_gpio(tb->sda, tb->mux, 0, 0, false, false);
+		touch_gpio(tb->scl, tb->mux, 0, 0, false, false);
+	}
+	st.probing = true;
+	/* fts_system_reset with a reset GPIO: low 10 ms, high, poll for READY */
+	touch_gpio(tb->rst, 0, 0, 0, true, false);
+	touch_wait(10);
+	touch_gpio(tb->rst, 0, 0, 0, true, true);
+	touch_wait(20);
+	printf("SWEET TOUCH: ftm5 reset pulsed, polling for READY\n");
+	TOUCH_STEP();
+	int err = touch_ftm5_wait(FTM5_EVT_READY, 1000);
+	printf("SWEET TOUCH: ftm5 reset at %#x: err=%d\n", FTM5_ADDR, err);
+	TOUCH_STEP();
+	if (!err) {
+		/* setScanMode(SCAN_MODE_ACTIVE, 0x01): mutual sense on */
+		const uint8_t sense_on[3] = {0xa0, 0x00, 0x01};
+		err = touch_write(FTM5_ADDR, sense_on, sizeof(sense_on));
+		printf("SWEET TOUCH: ftm5 sense on err=%d\n", err);
+	}
+	st.probing = false;
+	if (err || st.dead) {
+		printf("SWEET TOUCH: no FTM5 at %#x (err=%d dead=%d); stopping\n",
+		    FTM5_ADDR, err, st.dead);
+		return false;
+	}
+	st.kind = TOUCH_FTM5;
+	return true;
+}
