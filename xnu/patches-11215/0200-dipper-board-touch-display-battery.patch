+/*
+ * Xiaomi Mi 8 (dipper) is SDM845 like the Poco F1 and its ADT also lists
+ * "xiaomi,beryllium", so every beryllium path (PMIC, USB, UFS, battery,
+ * WCN3990, A630, cpufreq) applies unchanged. Only these differ:
+ * Samsung EA8074 AMOLED 1080x2248 in DSI command mode (no WLED), and an
+ * ST FTM5 touch controller at 0x49 on the same I2C14 bus and pins.
+ */
+static inline bool
+sweet_board_dipper(void)
+{
+	static int cached = -1;
+	if (cached < 0) {
+		cached = sweet_board_is("xiaomi,dipper") ? 1 : 0;
+	}
+	return cached == 1;
+}
+
 #endif /* _SWEET_BOARD_H_ */
