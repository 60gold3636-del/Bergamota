+/*
+ * FTM5 event FIFO: every read of 0x86 pops events; byte 7 of the first one
+ * counts the events still queued. Contacts persist across reads (the IC
+ * reports only changes), so start from the current state and apply them.
+ */
+static int
+touch_ftm5(void)
+{
+	uint8_t buf[FTM5_EVT_SIZE * FTM5_EVT_BURST];
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+	uint32_t mask = st.active;
+	memcpy(x, st.x, sizeof(x));
+	memcpy(y, st.y, sizeof(y));
+	int err = touch_read(FTM5_ADDR, FTM5_READ_FIFO, false, buf, FTM5_EVT_SIZE);
+	if (err) {
+		return err;
+	}
+	unsigned n = 1u + (buf[7] & 0x1fu);
+	n = n > FTM5_EVT_BURST ? FTM5_EVT_BURST : n; /* the rest keeps the IRQ low */
+	if (n > 1) {
+		err = touch_read(FTM5_ADDR, FTM5_READ_FIFO, false, buf + FTM5_EVT_SIZE,
+		    FTM5_EVT_SIZE * (n - 1u));
+		if (err) {
+			n = 1;
+		}
+	}
+	bool changed = false;
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *e = buf + FTM5_EVT_SIZE * i;
+		unsigned id = e[1] >> 4;
+		if (e[0] == 0) {
+			break; /* EVT_ID_NOEVENT: FIFO empty */
+		}
+		if (touch_trace) {
+			printf("F5 %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7]);
+		}
+		if (e[0] == FTM5_EVT_ERROR) {
+			printf("SWEET TOUCH: ftm5 error event type=%#x %02x %02x\n", e[1], e[2], e[3]);
+			continue;
+		}
+		if (id >= TOUCH_MAX) {
+			continue;
+		}
+		if (e[0] == FTM5_EVT_LEAVE ||
+		    ((e[0] == FTM5_EVT_ENTER || e[0] == FTM5_EVT_MOTION) &&
+		    (e[1] & 15u) == FTM5_TYPE_HOVER)) {
+			mask &= ~(1u << id);
+			changed = true;
+			continue;
+		}
+		if (e[0] != FTM5_EVT_ENTER && e[0] != FTM5_EVT_MOTION) {
+			continue; /* status, user (keys/gestures) and debug events */
+		}
+		unsigned px = ((unsigned)(e[3] & 15u) << 8) | e[2];
+		unsigned py = ((unsigned)e[4] << 4) | (e[3] >> 4);
+		if (px >= tb->w || py >= tb->h) {
+			continue;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		changed = true;
+	}
+	if (changed) {
+		touch_report(mask, x, y);
+	}
+	return 0;
+}
+
+/* Wait up to ms for one event id in the FIFO, popping the others. */
+static int
+touch_ftm5_wait(uint8_t want, unsigned ms)
+{
+	uint8_t e[FTM5_EVT_SIZE];
+	int err = ETIMEDOUT;
+	for (unsigned t = 0; t < ms; t += 10) {
+		memset(e, 0, sizeof(e));
+		err = touch_read(FTM5_ADDR, FTM5_READ_FIFO, false, e, sizeof(e));
+		if (!err && e[0] == want) {
+			return 0;
+		}
+		if (!err && e[0] == FTM5_EVT_ERROR) {
+			printf("SWEET TOUCH: ftm5 error event during reset type=%#x\n", e[1]);
+		}
+		if (st.dead) {
+			return EIO;
+		}
+		touch_wait(10);
+	}
+	return err ? err : ETIMEDOUT;
+}
