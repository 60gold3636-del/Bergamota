+	PE_parse_boot_argn("sweetfb_cmd", &mode, sizeof(mode));
+	for (uint32_t i = 0; i < 5; i++) {
+		uint32_t top = mdp_rd(mdp + SWEET_MDP_CTL0 + SWEET_MDP_CTL_STRIDE * i, SWEET_MDP_CTL_TOP);
+		if (top != 0) {
+			IOLog("SWEET MDP: CTL%u top 0x%08x%s\n", i, top,
+			    i != 0 ? "  (flushes go to CTL0 only: not supported yet)" : "");
+		}
+	}
+	for (int i = 0; i < 4; i++) {
+		vm_offset_t b = mdp + SWEET_MDP_PP0 + SWEET_MDP_PP_STRIDE * (uint32_t)i;
+		uint32_t te = mdp_rd(b, PP_TEAR_CHECK_EN);
+		IOLog("SWEET MDP: PP%d tear-check 0x%x vsync-cfg 0x%08x autorefresh 0x%08x line %u\n",
+		    i, te, mdp_rd(b, PP_SYNC_CONFIG_VSYNC), mdp_rd(b, PP_AUTOREFRESH_CONFIG),
+		    mdp_rd(b, PP_LINE_COUNT));
+		if ((te & 1u) && pp < 0) {
+			pp = i;
+		}
+	}
+	if (mode == 0 || mode > 2) {
+		IOLog("SWEET MDP: command-mode refresh off (sweetfb_cmd=%u)\n", mode);
+		return;
+	}
+	if (pp < 0) {
+		IOLog("SWEET MDP: no tear-checked pingpong: not a command-mode path; refresh unchanged\n");
+		return;
+	}
+	if (mode == 1 && (mdp_rd(mdp + SWEET_MDP_PP0 + SWEET_MDP_PP_STRIDE * (uint32_t)pp,
+	    PP_AUTOREFRESH_CONFIG) & (1u << 31))) {
+		/*
+		 * Mi 8 ABL leaves autorefresh running (0x80000001). Starting a frame on top of it
+		 * wedged the DSI in Enxerto (STATUS 0x5, HS FIFO underflow, white panel): keep it.
+		 */
+		IOLog("SWEET MDP: PP%d autorefresh already on (ABL); left as is\n", pp);
+		sweet_mdp_cmd = 1;
+		return;
+	}
+	if (mode == 1) {
+		vm_offset_t b = mdp + SWEET_MDP_PP0 + SWEET_MDP_PP_STRIDE * (uint32_t)pp;
+		mdp_wr(b, PP_AUTOREFRESH_CONFIG, (1u << 31) | 1u);   /* enable, every TE */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		mdp_wr(mdp + SWEET_MDP_CTL0, SWEET_MDP_CTL_START, 1); /* first frame starts the loop */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		/* the read pointer moves while frames are sent; sample it over ~40 ms */
+		uint32_t first = mdp_rd(b, PP_LINE_COUNT), moved = 0;
+		for (uint32_t i = 0; i < 20; i++) {
+			IODelay(2000);
+			moved += mdp_rd(b, PP_LINE_COUNT) != first;
+		}
+		if (moved == 0) {
+			mdp_wr(b, PP_AUTOREFRESH_CONFIG, 0);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			IOLog("SWEET MDP: PP%d autorefresh did not run (line count stuck at %u); one frame per flush instead\n",
+			    pp, first);
+			mode = 2;
+		} else {
+			IOLog("SWEET MDP: PP%d autorefresh on (line count moved %u/20)\n", pp, moved);
+		}
+	}
+	sweet_mdp_cmd = mode;
+	if (mode == 2) {
+		IOLog("SWEET MDP: command mode: CTL_START after every flush (needs sweetfb_flip=1)\n");
+	}
+}
