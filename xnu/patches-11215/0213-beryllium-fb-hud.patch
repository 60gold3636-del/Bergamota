+/*
+ * Performance HUD (patch 0213).
+ *
+ * Boot-arg sweetfb_hud=1 sets the initial value of sysctl kern.sweet_fb_hud (bsd/dev/sweet_fb.c), 0 = off.
+ * Rows (every 500 ms, one window):
+ *   DISP  frames pushed to the panel per second (zero-copy + copy), and the vsync rate in Hz
+ *   APP   backboardd swaps per second, and the ones coalesced (replaced before they were shown)
+ *   COPY  copy time per frame, average and maximum of the window (latch waits and the HUD excluded)
+ *   GPU   MHz, level, busy % and governor mode (sweet_a630.c, as kern.sweet_gpu)
+ *   CPU   current MHz of the A55 and A75 clusters (sweet_cpufreq.c, live PERF_STATE)
+ *   BAT   percent and charge current, + charging (SweetBattery.cpp; "--" until it published)
+ * Everything is read through exported getters or the driver's own counters: nothing is parsed, and the
+ * only per frame work is hudBlit (write-only, no allocation). The buffers we draw into are write-combined
+ * mappings (kIOMapWriteCombineCache), so a "dsb sy" is the whole cache maintenance; there are no dirty
+ * lines to clean. The box sits at the left below the status bar (y = height / 16), clear of the clock.
+ */
+bool
+AppleCLCD::hudUsable(void)
+{
+	if (fZc && fZcOK) {
+		if (!fHudWarned) {
+			fHudWarned = true;
+			IOLog("SWEET FB: HUD unavailable with %s scan-out (the scanned buffer is the app's IOSurface): kern.sweet_fb_hud ignored\n",
+			    fDirect ? "direct" : "zero-copy");
+		}
+		return false;
+	}
+	return true;
+}
+
+bool
+AppleCLCD::hudSetup(void)
+{
+	bool hwFrame = fHw && fFlip;
+	uint32_t bw = hwFrame ? fLogicalW : fWidth, bh = hwFrame ? fLogicalH : fHeight;
+	uint32_t s = bw >= 1000 ? 3 : 2;
+	uint32_t pad = 2 * s;
+	uint32_t w = SWEET_FB_HUD_COLS * 8 * s + 2 * pad, h = SWEET_FB_HUD_ROWS * 16 * s + 2 * pad;
+
+	if (w + 8 > bw || h + bh / 16 > bh) {
+		fHudWarned = true;
+		IOLog("SWEET FB: HUD does not fit the %ux%u buffer\n", bw, bh);
+		return false;
+	}
+	fHudImg = (uint32_t *)IOMallocData((size_t)w * h * sizeof(uint32_t));       /* once, never per frame */
+	if (fHudImg == NULL) {
+		fHudWarned = true;
+		IOLog("SWEET FB: HUD: no memory for the box image\n");
+		return false;
+	}
+	fHudW = w;
+	fHudH = h;
+	fHudX = 8;
+	fHudY = bh / 16;
+	fHudScale = s;
+	IOLog("SWEET FB: HUD box %ux%u at %u,%u in the %ux%u %s buffer, font x%u\n", w, h, fHudX, fHudY, bw, bh,
+	    hwFrame ? "canvas" : "panel", s);
+	return true;
+}
+
+/* Paint the text rows into the box image: stipple background, black outline, white glyphs. */
+void
+AppleCLCD::hudRender(void)
+{
+	const uint32_t W = fHudW, s = fHudScale, pad = 2 * s;
+	const uint32_t black = 0xff000000u, white = 0xffffffffu;
+
+	for (uint32_t y = 0; y < fHudH; y++) {
+		uint32_t *row = fHudImg + (size_t)y * W;
+		for (uint32_t x = 0; x < W; x++) {
+			row[x] = ((x + y) & 1) ? 0 : black;     /* every other pixel: 50% opaque, no read of the frame */
+		}
+	}
+	for (uint32_t r = 0; r < SWEET_FB_HUD_ROWS; r++) {
+		for (uint32_t c = 0; c < SWEET_FB_HUD_COLS && fHudText[r][c] != 0; c++) {
+			unsigned char ch = (unsigned char)fHudText[r][c];
+			if (ch == ' ') {
+				continue;
+			}
+			const unsigned char *g = iso_font + ch * 16;
+			for (int pass = 0; pass < 2; pass++) {
+				for (int gy = 0; gy < 16; gy++) {
+					for (int gx = 0; gx < 8; gx++) {
+						bool on = (g[gy] >> gx) & 1;
+						uint32_t color;
+						if (pass == 0) {
+							/* outline: an unset pixel next to a set one (inside the cell) */
+							if (on ||
+							    !((gx > 0 && ((g[gy] >> (gx - 1)) & 1)) || (gx < 7 && ((g[gy] >> (gx + 1)) & 1)) ||
+							    (gy > 0 && ((g[gy - 1] >> gx) & 1)) || (gy < 15 && ((g[gy + 1] >> gx) & 1)))) {
+								continue;
+							}
+							color = black;
+						} else {
+							if (!on) {
+								continue;
+							}
+							color = white;
+						}
+						uint32_t px = pad + (c * 8 + (uint32_t)gx) * s, py = pad + (r * 16 + (uint32_t)gy) * s;
+						for (uint32_t yy = 0; yy < s; yy++) {
+							uint32_t *d = fHudImg + (size_t)(py + yy) * W + px;
+							for (uint32_t xx = 0; xx < s; xx++) {
+								d[xx] = color;
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+}
+
+/* Write the box into the frame at base (stride in bytes): only the box rectangle, write-only. */
+void
+AppleCLCD::hudBlit(uintptr_t base, uint32_t stride)
+{
+	uint64_t t0 = mach_absolute_time();
+
+	for (uint32_t y = 0; y < fHudH; y++) {
+		const uint32_t *src = fHudImg + (size_t)y * fHudW;
+		uint32_t *dst = (uint32_t *)(base + (uint64_t)(fHudY + y) * stride) + fHudX;
+		for (uint32_t x = 0; x < fHudW; x++) {
+			uint32_t v = src[x];
+			if (v != 0) {
+				dst[x] = v;
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");       /* write-combined mapping: nothing to clean, the writes must land */
+	fHudDrawAbs += mach_absolute_time() - t0;
+}
+
+/* Every vsync tick: cheap when off; every 500 ms one window of numbers, a new box image, and a redraw if the screen is still. */
+void
+AppleCLCD::hudTick(uint64_t now)
+{
+	if (__atomic_load_n(&sweet_fb_hud, __ATOMIC_RELAXED) == 0) {
+		fHudReady = false;      /* the next enable starts a fresh window */
+		fHudT = 0;
+		return;
+	}
+	if (!hudUsable() || (fHudImg == NULL && (fHudWarned || !hudSetup()))) {
+		return;
+	}
+	uint64_t swaps, coalesced;
+	IOLockLock(fLock);
+	swaps = fSt.swaps;
+	coalesced = fSt.coalesced;
+	IOLockUnlock(fLock);
+	if (fHudT == 0) {
+		fHudT = now;
+		fHudPrev.swaps = swaps;
+		fHudPrev.coalesced = coalesced;
+		fHudPrev.zc = fSt.zc;
+		fHudPrev.copy = fSt.copy;
+		fHudPrev.copyAbs = fSt.copyAbs;
+		fHudCopyMaxAbs = 0;
+		return;
+	}
+	uint64_t winUS = sweet_abs_us(now - fHudT);
+	if (winUS < SWEET_FB_HUD_PERIOD_US) {
+		return;
+	}
+	uint64_t dSw = swaps - fHudPrev.swaps, dCo = coalesced - fHudPrev.coalesced;
+	uint64_t dFr = (fSt.zc - fHudPrev.zc) + (fSt.copy - fHudPrev.copy), dCp = fSt.copy - fHudPrev.copy;
+	#define HUD_S10(n) ((unsigned)((uint64_t)(n) * 10000000ull / winUS))   /* per second x10 */
+	uint64_t cpAvg = dCp ? sweet_abs_us(fSt.copyAbs - fHudPrev.copyAbs) / dCp : 0;
+	uint64_t cpMax = sweet_abs_us(fHudCopyMaxAbs);
+	unsigned gmhz = 0, glvl = 0, gbusy = 0, a55 = 0, a75 = 0;
+	int ggov = 0, gstate = 0, bpct = 0, bma = 0;
+	sweet_gpu_hud_state(&gmhz, &glvl, &gbusy, &ggov, &gstate);
+	sweet_cpufreq_hud_mhz(&a55, &a75);
+	int bat = sweet_battery_hud(&bpct, &bma);
+	unsigned fr = HUD_S10(dFr), sw = HUD_S10(dSw), co = HUD_S10(dCo);
+	uint32_t hz = fVsyncUS ? 1000000u / fVsyncUS : 0;
+	snprintf(fHudText[0], sizeof(fHudText[0]), "DISP %u.%u/s  VSYNC %uHz", fr / 10, fr % 10, hz);
+	snprintf(fHudText[1], sizeof(fHudText[1]), "APP  %u.%u/s  COAL %u.%u/s", sw / 10, sw % 10, co / 10, co % 10);
+	snprintf(fHudText[2], sizeof(fHudText[2]), "COPY %u.%ums MAX %u.%ums", (unsigned)(cpAvg / 1000),
+	    (unsigned)(cpAvg % 1000 / 100), (unsigned)(cpMax / 1000), (unsigned)(cpMax % 1000 / 100));
+	if (gstate == 1) {
+		snprintf(fHudText[3], sizeof(fHudText[3]), "GPU %uMHz L%u %u%% %s", gmhz, glvl, gbusy, ggov ? "gov" : "fixed");
+	} else {
+		snprintf(fHudText[3], sizeof(fHudText[3]), "GPU %s", gstate == 0 ? "off" : (gstate == 2 ? "slumber" : "lost"));
+	}
+	snprintf(fHudText[4], sizeof(fHudText[4]), "CPU A55 %u A75 %uMHz", a55, a75);
+	if (bat) {
+		snprintf(fHudText[5], sizeof(fHudText[5]), "BAT %d%% %c%dmA", bpct, bma < 0 ? '-' : '+', bma < 0 ? -bma : bma);
+	} else {
+		snprintf(fHudText[5], sizeof(fHudText[5]), "BAT --");
+	}
+	#undef HUD_S10
+	hudRender();
+	fHudReady = true;
+	fHudT = now;
+	fHudPrev.swaps = swaps;
+	fHudPrev.coalesced = coalesced;
+	fHudPrev.zc = fSt.zc;
+	fHudPrev.copy = fSt.copy;
+	fHudPrev.copyAbs = fSt.copyAbs;
+	fHudCopyMaxAbs = 0;
+	/*
+	 * A frame waiting for the next tick draws the box itself (present). Otherwise the screen is still:
+	 * draw into what the panel scans now, once a frame was copied (not over the boot console or the
+	 * power-off fade). The box then belongs to that frame; the next copied frame brings its own.
+	 */
+	if (fCopyFrames != 0 && !fPowerOff && !fDirty && !(fFlip && fFront == 0)) {
+		hudBlit(fFlip ? fBufVA[fFront] : fPixels, fHw && fFlip ? fHwStride : fRowBytes);
+	}
+}
